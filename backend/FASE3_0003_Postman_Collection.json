						"url": {
							"raw": "{{base_url}}/api/communities/{{community_id}}/comments/{{comment_id}}/",
							"host": ["{{base_url}}"],
							"path": ["api", "communities", "{{community_id}}", "comments", "{{comment_id}}", ""]
						}
					}
				},
				{
