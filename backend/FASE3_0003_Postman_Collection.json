{
	"info": {
		"_postman_id": "fase3-0003-comments-api",
		"name": "FASE3-0003: Comments API with Threading",
		"description": "Colección completa para testing del sistema de comentarios con threading de 3 niveles",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🏗️ Setup & Auth",
			"item": [
				{
					"name": "Login Usuario Test",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('access_token', response.access);",
									"    pm.environment.set('refresh_token', response.refresh);",
									"    console.log('🔑 Token guardado exitosamente');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"testpass123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				}
			]
		},
		{
			"name": "📝 Comments CRUD",
			"item": [
				{
					"name": "Listar Comentarios de Comunidad",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/communities/{{community_id}}/comments/?ordering=thread_path",
							"host": ["{{base_url}}"],
							"path": ["api", "communities", "{{community_id}}", "comments", ""],
							"query": [
								{
									"key": "ordering",
									"value": "thread_path"
								}
							]
						}
					}
				},
				{
					"name": "Crear Comentario Principal",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('comment_id', response.id);",
									"    console.log('📝 Comentario creado con ID:', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Este es un comentario principal de prueba. Perfecto para testing del sistema de threading.\",\n    \"post\": {{post_id}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/communities/{{community_id}}/comments/",
							"host": ["{{base_url}}"],
							"path": ["api", "communities", "{{community_id}}", "comments", ""]
						}
					}
				},
