	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script para logs automáticos",
					"console.log('🚀 Ejecutando:', pm.info.requestName);",
					"console.log('🌐 URL:', pm.request.url);",
					"console.log('⏰ Timestamp:', new Date().toISOString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Tests automáticos para todas las requests",
					"pm.test('✅ Status code es 200 o 404', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
					"});",
					"",
					"pm.test('⏱️ Response time menor a 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"if (pm.response.code === 200) {",
					"    pm.test('📋 Response tiene Content-Type JSON', function () {",
					"        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"    });",
					"    ",
					"    pm.test('📊 Response body es JSON válido', function () {",
					"        pm.response.to.have.jsonBody();",
					"    });",
					"}",
					"",
					"// Log de resultados",
					"console.log('✅ Test completado:', pm.info.requestName);",
					"console.log('📊 Status:', pm.response.code);",
					"console.log('⏱️ Time:', pm.response.responseTime + 'ms');"
				]
			}
		}
	],
