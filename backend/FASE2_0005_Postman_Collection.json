{
	"info": {
		"_postman_id": "fase2-0005-api-collection",
		"name": "FASE2-0005: Filtros por Tipo de Juego y Categorías",
		"description": "Colección completa para probar todas las APIs implementadas en FASE2-0005\n\n🎯 **Funcionalidades incluidas:**\n- GameType APIs (CRUD y filtros)\n- CommunityTag APIs (búsqueda y sugerencias)\n- Filtros avanzados\n- Estadísticas en tiempo real\n\n📅 **Fecha:** 14 de Agosto, 2025\n🏷️ **Versión:** 1.0.0",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🎮 GameType APIs",
			"item": [
				{
					"name": "📋 Lista todos los GameTypes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/",
							"host": ["{{base_url}}"],
							"path": ["api", "games", ""]
						},
						"description": "Obtiene la lista completa de tipos de juego disponibles con paginación."
					},
					"response": []
				},
				{
					"name": "⭐ GameTypes Destacados",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/featured/",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "featured", ""]
						},
						"description": "Obtiene solo los GameTypes marcados como destacados (is_featured=True)."
					},
					"response": []
				},
				{
					"name": "🔍 GameTypes con Filtros",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/?featured=true&ordering=-community_count",
							"host": ["{{base_url}}"],
							"path": ["api", "games", ""],
							"query": [
								{
									"key": "featured",
									"value": "true",
									"description": "Filtrar solo games destacados"
								},
								{
									"key": "ordering",
									"value": "-community_count",
									"description": "Ordenar por comunidades (descendente)"
								}
							]
						},
						"description": "Ejemplo de filtrado: games destacados ordenados por número de comunidades."
					},
					"response": []
				},
				{
					"name": "📄 Detalle de GameType específico",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/1/",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "1", ""]
						},
						"description": "Obtiene información detallada de un GameType específico (ID=1: Magic: The Gathering)."
					},
					"response": []
				},
				{
					"name": "🏘️ Comunidades de un GameType",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/1/communities/",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "1", "communities", ""]
						},
						"description": "Lista todas las comunidades públicas asociadas a un GameType específico."
					},
					"response": []
				},
				{
					"name": "📊 Ordenamiento por Año de Lanzamiento",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/games/?ordering=release_year",
							"host": ["{{base_url}}"],
							"path": ["api", "games", ""],
							"query": [
								{
									"key": "ordering",
									"value": "release_year",
									"description": "Ordenar por año de lanzamiento (ascendente)"
								}
							]
						},
						"description": "GameTypes ordenados por año de lanzamiento, del más antiguo al más reciente."
					},
					"response": []
				}
			],
			"description": "APIs para gestión de tipos de juego (Magic, Pokemon, Yu-Gi-Oh!, etc.)"
		},
